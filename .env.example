# Local Database & Cache (Docker Compose)
POSTGRES_USER=aetheria
POSTGRES_PASSWORD=aetheria_dev_pass
POSTGRES_DB=aetheria_overdrive
POSTGRES_DSN=postgres://aetheria:aetheria_dev_pass@localhost:5432/aetheria_overdrive?sslmode=disable
REDIS_ADDR=localhost:6379

# Service Ports
BACKEND_PORT=8080
SERVER_PORT=8081

# Security Secrets (CHANGE IN PRODUCTION)
JWT_SECRET=dev_jwt_secret_change_me_in_production_32chars
SERVER_INTERNAL_SECRET=dev_internal_hmac_secret_change_me_32chars
